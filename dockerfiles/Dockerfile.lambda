# =============================================================================
# Dockerfile.lambda — AWS Lambda function
# Build: docker build -f Dockerfile.lambda -t waphl-data_lambda .
# =============================================================================

# Lambda requires the AWS base image — cannot extend Dockerfile.base directly
FROM public.ecr.aws/lambda/python:3.12

# -----------------------------------------------------------------------------
# Pin setuptools (same firecloud workaround)
# -----------------------------------------------------------------------------
RUN pip install --no-cache-dir "setuptools<74" pip --upgrade

# -----------------------------------------------------------------------------
# Copy and install package
# -----------------------------------------------------------------------------
COPY pyproject.toml /build/
COPY . /build/
COPY ./schemes/ /schemes/

RUN pip install --no-cache-dir --no-build-isolation /build/ && rm -rf /build