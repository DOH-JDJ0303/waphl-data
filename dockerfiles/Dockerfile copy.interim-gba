# =============================================================================
# Dockerfile.interim-gba — Interim GBA CSV Export AWS Lambda Function
# TEMPORARY: stop-gap exporter (Delta workflow_alt=phoenix -> tables/gba.csv).
#            Expected to be removed once the permanent reporting pipeline lands.
# Build: docker build -f Dockerfile.interim-gba -t interim-gba .
# =============================================================================
 
FROM waphl-data-lambda:latest
 
# -----------------------------------------------------------------------------
# Point to the handler inside the installed package.
# -----------------------------------------------------------------------------
CMD ["interim_gba.lambda_function.handler"]